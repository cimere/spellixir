{
  parserClass="com.cimere.spellixir.lang.parser.ElixirParser"
  parserUtilClass="com.cimere.spellixir.lang.ElixirParserUtil"
  elementTypeHolderClass="com.cimere.spellixir.lang.psi.ElixirTypes"
  elementTypeFactory="com.cimere.spellixir.lang.ElixirParserDefinition.createElementType"

  psiPackage="com.cimere.spellixir.lang.psi"
  psiImplPackage="com.cimere.spellixir.lang.psi.impl"
  psiClassPrefix="Elixir"
  psiImplClassSuffix="Impl"

  tokens=[
    ALIAS="ALIAS"
    ATOM="ATOM"
    BRACES="BRACES"
    BRACKETS="BRACKETS"
    CAPTURE="CAPTURE"
    CHARACTER="CHARACTER"
    ESCAPE="ESCAPE"
    FUNCTION_DECLARATION="FUNCTION_DECLARATION"
    IDENTIFIER="IDENTIFIER"
    INTERPOLATION="INTERPOLATION"
    KEYWORD="KEYWORD"
    LITERAL="LITERAL"
    MEMBER_ACCESS="MEMBER_ACCESS"
    MODULE_ATTRIBUTE="MODULE_ATTRIBUTE"
    NUMBER="NUMBER"
    OPERATOR="OPERATOR"
    PARENTHESES="PARENTHESES"
    PUNCTUATION="PUNCTUATION"
    SIGIL="SIGIL"
    STRING="STRING"
  ]
}

elixir_file ::= form*

private form ::= !end_keyword (module_declaration | callable_declaration | alias_declaration | expression | unexpected_token)

module_declaration ::= defmodule_keyword qualified_name do_block

alias_declaration ::= alias_keyword qualified_name

callable_declaration ::= def_keyword callable_name parameter_list? callable_body?

callable_name ::= FUNCTION_DECLARATION | IDENTIFIER

callable_body ::= comma do_atom expression | do_block

do_block ::= do_keyword form* end_keyword

parameter_list ::= left_parenthesis [pattern (comma pattern)*] right_parenthesis

pattern ::= expression

expression ::= primary_expression (OPERATOR primary_expression)*

private primary_expression ::= call_expression
                             | list_expression
                             | tuple_expression
                             | map_expression
                             | parenthesized_expression
                             | qualified_name
                             | literal_expression
                             | capture_expression
                             | reference_name

call_expression ::= qualified_name argument_list | reference_name argument_list | call_without_parentheses

call_without_parentheses ::= reference_name no_parentheses_argument (comma no_parentheses_argument)*

private no_parentheses_argument ::= list_expression
                                  | tuple_expression
                                  | map_expression
                                  | parenthesized_expression
                                  | qualified_name
                                  | literal_expression
                                  | capture_expression
                                  | reference_name

argument_list ::= left_parenthesis [expression (comma expression)*] right_parenthesis

list_expression ::= left_bracket [expression (comma expression)*] right_bracket

tuple_expression ::= left_brace [expression (comma expression)*] right_brace

map_expression ::= percent left_brace [expression (comma expression)*] right_brace

parenthesized_expression ::= left_parenthesis expression right_parenthesis

qualified_name ::= reference_name (dot reference_name)+

reference_name ::= ALIAS | IDENTIFIER | MEMBER_ACCESS | MODULE_ATTRIBUTE

literal_expression ::= ATOM | LITERAL | NUMBER | CHARACTER | quoted_literal | sigil_literal

private quoted_literal ::= STRING (ESCAPE | interpolation)* STRING?
private sigil_literal ::= SIGIL (ESCAPE | interpolation)* SIGIL?
private interpolation ::= INTERPOLATION expression INTERPOLATION

capture_expression ::= CAPTURE | OPERATOR reference_name OPERATOR NUMBER

private defmodule_keyword ::= <<parseTokenText "defmodule">>
private alias_keyword ::= <<parseTokenText "alias">>
private def_keyword ::= <<parseTokenText "def">> | <<parseTokenText "defp">> | <<parseTokenText "defmacro">> | <<parseTokenText "defguard">>
private do_keyword ::= <<parseTokenText "do">>
private end_keyword ::= <<parseTokenText "end">>
private do_atom ::= <<parseTokenText "do:">>
private comma ::= <<parseTokenText ",">>
private dot ::= <<parseTokenText ".">>
private percent ::= <<parseTokenText "%">>
private left_parenthesis ::= <<parseTokenText "(">>
private right_parenthesis ::= <<parseTokenText ")">>
private left_bracket ::= <<parseTokenText "[">>
private right_bracket ::= <<parseTokenText "]">>
private left_brace ::= <<parseTokenText "{">>
private right_brace ::= <<parseTokenText "}">>
private unexpected_token ::= <<consumeUnexpectedToken>>
