<idea-plugin>
  <id>com.cimere.spellixir</id>
  <name>Spellixir</name>
  <vendor>cimere</vendor>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType
        name="Elixir"
        implementationClass="com.cimere.spellixir.lang.ElixirFileType"
        fieldName="INSTANCE"
        language="Elixir"
        extensions="ex;exs" />
    <lang.syntaxHighlighterFactory
        language="Elixir"
        implementationClass="com.cimere.spellixir.lang.ElixirSyntaxHighlighterFactory" />
  </extensions>
</idea-plugin>
